rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Solo estas cuentas pueden ver y cambiar los datos de la carnicería.
    // Pon aquí los correos con los que entráis (en minúsculas).
    function permitido() {
      return request.auth != null
        && request.auth.token.email in [
          'llanastomas@gmail.com',
          'maryjosellanas@gmail.com',
          'alvarollanasmartinez@hotmail.com',
          'maribelllanas1983@gmail.com'
        ];
    }
    match /negocio/{app}/{resto=**} {
      allow read: if permitido();
      // el fichaje tiene sus propias reglas abajo
      allow write: if permitido() && app != 'fichaje';
    }
    match /negocio/fichaje/centros/{id} {
      allow write: if permitido();
    }
    // Registro de jornada: cada persona ficha solo a su nombre y nadie puede cambiar ni borrar un fichaje.
    match /negocio/fichaje/registros/{id} {
      allow create: if permitido()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.tipo in ['entrada', 'salida']
        && request.resource.data.ts is number;
    }
  }
}
