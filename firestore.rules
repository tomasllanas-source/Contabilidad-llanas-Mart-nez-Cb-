rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Solo estas cuentas pueden ver y cambiar los datos de la carnicería.
    // Pon aquí los correos con los que entráis (en minúsculas).
    function permitido() {
      return request.auth != null
        && request.auth.token.email in [
          'llanastomas@gmail.com',
          'maryjosellanas@gmail.com',
          'alvarollanasmartinez@hotmail.com'
        ];
    }
    match /negocio/{resto=**} {
      allow read, write: if permitido();
    }
  }
}
